@using Optimizely26.Models.Pages
@using Optimizely26.Models.ViewModels

@model IPageViewModel<SitePageData>

<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.CurrentPage.Name</title>
    <meta name="description" content="@Model.CurrentPage.MetaDescription" />
    <base href="~/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/find.css" rel="stylesheet" />
    <link href="~/css/carousel.css" rel="stylesheet" />
</head>

<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <nav class="navbar navbar-expand-lg bg-dark border-bottom border-body" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="/">
                <i class="fas fa-film me-2 text-warning"></i>Movie Finder
            </a>
        </div>
    </nav>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="py-4 border-top bg-body">
        <div class="container small text-body-secondary text-center">
            Movie data from <a href="https://www.omdbapi.com/" class="link-secondary" target="_blank" rel="noopener">OMDb API</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
