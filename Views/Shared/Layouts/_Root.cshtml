@using Optimizely26.Models.Pages
@using Optimizely26.Models.ViewModels

@model IPageViewModel<SitePageData>

<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.PageTitle</title>
    <meta name="description" content="@Model.MetaDescription" />
    <base href="~/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/menu.css" rel="stylesheet" />
    <link href="~/css/find.css" rel="stylesheet" />
    <link href="~/css/carousel.css" rel="stylesheet" />
    <link href="~/css/movie.css" rel="stylesheet" />
    <link href="~/css/find-page.css" rel="stylesheet" />
    <link href="~/css/contact-form.css" rel="stylesheet" />
</head>

<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    @await Html.PartialAsync("Menu", Model)

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="py-4 border-top bg-body">
        <div class="container small text-body-secondary text-center">
            Movie data from <a href="https://www.omdbapi.com/" class="link-secondary" target="_blank" rel="noopener">OMDb API</a>
        </div>
    </footer>

    @* Blazor shows this when a component fails or the connection to the server is lost *@
    <div id="blazor-error-ui" class="alert alert-danger position-fixed bottom-0 start-50 translate-middle-x mb-3 shadow" style="display: none" role="alert">
        Something went wrong. <a href="" class="reload alert-link">Reload the page</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
